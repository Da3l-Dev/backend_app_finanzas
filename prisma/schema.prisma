generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum AccountType {
  CASH
  DEBIT_CARD
  CREDIT_CARD
  SAVINGS
  INVESTMENT
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  EXPENSE
  INCOME
  TRANSFER
  CREDIT_CARD_PAYMENT
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  POSTED
  VOIDED
}

enum DebtType {
  I_OWE
  OWED_TO_ME
}

enum DebtStatus {
  ACTIVE
  PAID
  CANCELLED
}

enum RecurrenceFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  YEARLY
}

enum TelegramAction {
  IDLE
  CREATE_EXPENSE
  CREATE_INCOME
  CREATE_TRANSFER
  CREATE_DEBT_PAYMENT
}

enum NotificationType {
  BUDGET_WARNING
  BUDGET_EXCEEDED
  GOAL_PROGRESS
  DEBT_DUE
  RECURRING_TRANSACTION
}

model User {
  id              String     @id @default(uuid())
  email           String     @unique
  phone           String?    @unique
  passwordHash    String
  firstName       String
  lastName        String?
  displayName     String?
  avatarUrl       String?
  defaultCurrency String     @default("MXN")
  timezone        String     @default("America/Mexico_City")
  locale          String     @default("es-MX")
  role            UserRole   @default(USER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  accounts              Account[]
  categories            Category[]
  budgets               Budget[]
  transactions          Transaction[]
  merchants             Merchant[]
  savingGoals           SavingGoal[]
  debts                 Debt[]
  recurringTransactions RecurringTransaction[]
  notifications         Notification[]
  telegramProfile       TelegramProfile?
  telegramConversation  TelegramConversation?
  sessions              Session[]
}

model Session {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model TelegramProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  chatId    String   @unique
  username  String?
  firstName String?
  linkedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TelegramConversation {
  id          String         @id @default(uuid())
  userId      String         @unique
  currentStep String         @default("IDLE")
  action      TelegramAction @default(IDLE)
  draftData   Json?
  expiresAt   DateTime?
  updatedAt   DateTime       @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String      @id @default(uuid())
  userId            String
  name              String
  type              AccountType
  institution       String?
  lastFourDigits    String?
  currency          String      @default("MXN")
  openingBalance    Decimal     @default(0) @db.Decimal(14, 2)
  creditLimit       Decimal?    @db.Decimal(14, 2)
  color             String?
  icon              String?
  isActive          Boolean     @default(true)
  includeInNetWorth Boolean     @default(true)
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  archivedAt        DateTime?

  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outgoingTransactions Transaction[]          @relation("SourceAccount")
  incomingTransactions Transaction[]          @relation("TargetAccount")
  recurringFrom        RecurringTransaction[] @relation("RecurringSourceAccount")
  recurringTo          RecurringTransaction[] @relation("RecurringTargetAccount")

  @@unique([userId, name])
  @@index([userId, type])
}

model Category {
  id        String       @id @default(uuid())
  userId    String?
  parentId  String?
  name      String
  type      CategoryType
  color     String?
  icon      String?
  isSystem  Boolean      @default(false)
  isActive  Boolean      @default(true)
  sortOrder Int          @default(0)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent       Category?              @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children     Category[]             @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]
  splits       TransactionSplit[]
  recurring    RecurringTransaction[]

  @@index([userId, type])
  @@index([parentId])
}

model Merchant {
  id             String   @id @default(uuid())
  userId         String
  name           String
  normalizedName String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name])
}

model Budget {
  id              String   @id @default(uuid())
  userId          String
  categoryId      String
  month           DateTime
  allocatedAmount Decimal  @db.Decimal(14, 2)
  warningPercent  Int      @default(80)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, month])
  @@index([userId, month])
}

model Transaction {
  id              String            @id @default(uuid())
  userId          String
  categoryId      String?
  merchantId      String?
  sourceAccountId String?
  targetAccountId String?
  recurringId     String?
  type            TransactionType
  status          TransactionStatus @default(POSTED)
  amount          Decimal           @db.Decimal(14, 2)
  currency        String            @default("MXN")
  exchangeRate    Decimal?          @db.Decimal(14, 6)
  description     String?
  notes           String?
  receiptUrl      String?
  occurredAt      DateTime
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  voidedAt        DateTime?

  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  category         Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  merchant         Merchant?             @relation(fields: [merchantId], references: [id], onDelete: SetNull)
  sourceAccount    Account?              @relation("SourceAccount", fields: [sourceAccountId], references: [id], onDelete: Restrict)
  targetAccount    Account?              @relation("TargetAccount", fields: [targetAccountId], references: [id], onDelete: Restrict)
  recurring        RecurringTransaction? @relation(fields: [recurringId], references: [id], onDelete: SetNull)
  splits           TransactionSplit[]
  goalContribution GoalContribution?
  debtPayment      DebtPayment?

  @@index([userId, occurredAt])
  @@index([sourceAccountId, occurredAt])
  @@index([targetAccountId, occurredAt])
  @@index([categoryId, occurredAt])
}

model TransactionSplit {
  id            String  @id @default(uuid())
  transactionId String
  categoryId    String
  amount        Decimal @db.Decimal(14, 2)
  note          String?

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([categoryId])
}

model SavingGoal {
  id           String    @id @default(uuid())
  userId       String
  name         String
  description  String?
  targetAmount Decimal   @db.Decimal(14, 2)
  targetDate   DateTime?
  color        String?
  icon         String?
  isArchived   Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([userId, isArchived])
}

model GoalContribution {
  id            String   @id @default(uuid())
  goalId        String
  transactionId String   @unique
  amount        Decimal  @db.Decimal(14, 2)
  note          String?
  occurredAt    DateTime @default(now())

  goal        SavingGoal  @relation(fields: [goalId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([goalId, occurredAt])
}

model Debt {
  id             String     @id @default(uuid())
  userId         String
  personName     String
  description    String?
  type           DebtType
  status         DebtStatus @default(ACTIVE)
  originalAmount Decimal    @db.Decimal(14, 2)
  currency       String     @default("MXN")
  startedAt      DateTime   @default(now())
  dueDate        DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments DebtPayment[]

  @@index([userId, status])
}

model DebtPayment {
  id            String   @id @default(uuid())
  debtId        String
  transactionId String   @unique
  amount        Decimal  @db.Decimal(14, 2)
  occurredAt    DateTime @default(now())
  note          String?

  debt        Debt        @relation(fields: [debtId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)

  @@index([debtId, occurredAt])
}

model RecurringTransaction {
  id              String              @id @default(uuid())
  userId          String
  categoryId      String?
  sourceAccountId String?
  targetAccountId String?
  type            TransactionType
  amount          Decimal             @db.Decimal(14, 2)
  description     String?
  frequency       RecurrenceFrequency
  interval        Int                 @default(1)
  startsAt        DateTime
  endsAt          DateTime?
  nextRunAt       DateTime
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  sourceAccount Account?      @relation("RecurringSourceAccount", fields: [sourceAccountId], references: [id], onDelete: SetNull)
  targetAccount Account?      @relation("RecurringTargetAccount", fields: [targetAccountId], references: [id], onDelete: SetNull)
  transactions  Transaction[]

  @@index([userId, nextRunAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  body      String
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  readAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
}
